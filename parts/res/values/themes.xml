<resources>
    <!-- 统一使用 Android 16 (Material 3 Expressive) 的 Settings 子页面主题。 -->
    <style name="Theme.XiaomiParts" parent="@style/Theme.SubSettingsBase.Expressive">
        <!-- 边到边显示，系统栏交给 CollapsingToolbarBaseActivity 处理 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- 分组标题：对应 Android 16 Settings 里的 section header -->
    <style name="TextAppearance.XiaomiParts.SectionHeader"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?android:attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
